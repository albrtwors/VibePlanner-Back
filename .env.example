# ==========================================
# VibePlanner-Back · Variables de entorno
# Copiá este archivo como .env y completá los valores reales.
# ==========================================

# --- BASE DE DATOS ---
# Si lo dejás vacío o comentado, la app usa el SQLite local (database.db),
# útil para desarrollo. En producción pegá la URL de Supabase/Postgres.
DATABASE_URL=
# DATABASE_URL=postgresql://usuario:clave@host:puerto/basededatos

# --- JWT ---
JWT_SECRET_KEY=cambiá-esto-por-una-clave-larga-y-aleatoria

# Clave para crear el admin inicial vía POST /api/auth/bootstrap-admin
BOOTSTRAP_KEY=1234

# --- CÓDIGOS DE AUTENTICACIÓN (verificación de email / reset de contraseña) ---
# Minutos de validez de cada código
AUTH_CODE_TTL_MINUTES=15
# Segundos mínimos entre un envío y el siguiente del mismo tipo de código
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
# Intentos permitidos antes de invalidar el código
AUTH_CODE_MAX_ATTEMPTS=5

# --- CORREO (Gmail con contraseña de aplicación) ---
# Sin estas dos variables la app entra en "modo desarrollo": los códigos se
# imprimen en la consola y también se devuelven en la respuesta de la API.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# true/false. Por defecto se activa solo si no hay credenciales de Gmail.
MAIL_DEV_MODE=true

# --- IA (Groq) ---
GROQ_API_KEY=